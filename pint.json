{
    "preset": "psr12",
    "include": [
        "src",
        "tests"
    ],
    "exclude": [
        "vendor"
    ],
    "rules": {
        "array_syntax": {
            "syntax": "short"
        },
        "ordered_imports": {
            "sort_algorithm": "alpha"
        },
        "no_unused_imports": true,
        "single_quote": true,
        "fully_qualified_strict_types": true
    }
}

